# Copy to .env and fill in (never commit .env to git)

# MongoDB — local Docker: mongodb://mongo:27017/smartfile
# MongoDB Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/smartfile?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/smartfile

# HTTP
PORT=3000
# Bind all interfaces in Docker; use 127.0.0.1 only if you want local-only
BIND_HOST=0.0.0.0
NODE_ENV=development

# CORS — your site origin in production, e.g. https://fileshare.example.com
# Use * for quick tests (not for strict production)
CORS_ORIGIN=*

# AWS (S3 uploads + pre-signed download URLs)
AWS_REGION=us-east-1
S3_BUCKET=your-unique-bucket-name

# Option A: access keys (simple for students; not ideal on a shared server)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret

# Option B: on EC2, omit keys and attach an IAM role with s3:PutObject, s3:GetObject
# to your bucket. Then leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY unset.

# Optional: if this app and Lambda use a known prefix, you can document it
# LAMBDA_LOG_PREFIX=uploads/
